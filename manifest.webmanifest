{
  "name": "Bowling Green Flood Map",
  "short_name": "BG Flood Map",
  "description": "3D flood risk map for Bowling Green and Warren County, KY: simulated flood depth and derived flow.",
  "id": "./viewer.html",
  "start_url": "./viewer.html",
  "scope": "./",
  "display": "standalone",
